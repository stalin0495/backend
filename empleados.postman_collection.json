{
  "info": {
    "name": "Gestión de Empleados - API v1",
    "_postman_id": "b7e2a9d0-1a2b-4c3d-9e4f-empleados0001",
    "description": "Colección de pruebas para el CRUD de Empleados (Retos 1 y 2: Repository Pattern, Zod DTOs y Response Wrapper).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "empleadoId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Listar empleados (completo)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/empleados", "host": ["{{baseUrl}}"], "path": ["empleados"] }
      }
    },
    {
      "name": "02 - Listar empleados (paginado)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados?page=1&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["empleados"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "03 - Crear empleado (válido)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.data && json.data._id) {",
              "    pm.collectionVariables.set('empleadoId', json.data._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Andrés Mendoza\",\n  \"cargo\": \"Arquitecto de Software\",\n  \"departamento\": \"Innovación\",\n  \"sueldo\": 4500\n}"
        },
        "url": { "raw": "{{baseUrl}}/empleados", "host": ["{{baseUrl}}"], "path": ["empleados"] }
      }
    },
    {
      "name": "04 - Crear empleado (inválido - dispara Zod 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"An\",\n  \"cargo\": \"Developer\",\n  \"departamento\": \"TI\",\n  \"sueldo\": -200\n}"
        },
        "url": { "raw": "{{baseUrl}}/empleados", "host": ["{{baseUrl}}"], "path": ["empleados"] }
      }
    },
    {
      "name": "05 - Obtener empleado por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["empleados", "{{empleadoId}}"]
        }
      }
    },
    {
      "name": "06 - Obtener empleado por ID inválido (dispara Zod 400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/id-no-valido",
          "host": ["{{baseUrl}}"],
          "path": ["empleados", "id-no-valido"]
        }
      }
    },
    {
      "name": "07 - Actualizar empleado (parcial)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sueldo\": 5200\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["empleados", "{{empleadoId}}"]
        }
      }
    },
    {
      "name": "08 - Eliminar empleado",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["empleados", "{{empleadoId}}"]
        }
      }
    },
    {
      "name": "09 - Empleado no encontrado (404 wrapper)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/64f1b2c3d4e5f6a7b8c9d0e1",
          "host": ["{{baseUrl}}"],
          "path": ["empleados", "64f1b2c3d4e5f6a7b8c9d0e1"]
        }
      }
    }
  ]
}
